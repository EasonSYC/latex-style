% Theorems - Theorems

\if@usebeamer

\theoremstyle{plain}
\newtheorem*{claim}{Claim}
\newtheorem*{proposition}{Proposition}

\else\if@useams

\theoremstyle{definition}
\newtheorem{definition}{Definition}[section]
\newtheorem{definition*}{Definition}[section]

\newcommand{\newtheoremalias}[2]{
    \newaliascnt{#1}{definition}
    \newtheorem{#1}[#1]{#2}
    \aliascntresetthe{#1}}

\theoremstyle{plain}
\newtheoremalias{theorem}{Theorem}
\newtheoremalias{lemma}{Lemma}
\newtheoremalias{claim}{Claim}
\newtheoremalias{corollary}{Corollary}
\newtheoremalias{proposition}{Proposition}

\else

\newtheorem[bodystyle=\normalfont\noindent,
            L]{definition}{Definition}[section]

\newtheorem[bodystyle=\normalfont\noindent,
            L]{definition*}{Definition}[section]

\newcommand{\newtheoremenv}[2]{
    \newaliascnt{#1}{definition}
    \newtheorem[M]{#1}[#1]{#2}
    \aliascntresetthe{#1}}

\newtheoremenv{theorem}{Theorem}
\newtheoremenv{lemma}{Lemma}
\newtheoremenv{claim}{Claim}
\newtheoremenv{corollary}{Corollary}
\newtheoremenv{proposition}{Proposition}

\fi\fi

% Theorems - Others

\if@usebeamer

\else\if@useams

\theoremstyle{definition}

\newtheoremalias{example}{Example}
\newtheoremalias{examples}{Examples}

\newtheorem*{example*}{Example}
\newtheorem*{examples*}{Examples}

\newtheorem{problem}{Problem}

\else

\newtheorem[bodystyle=\normalfont\noindent,
            S]{problem}{Problem}

\newcommand{\newexampleenv}[2]{
    \newaliascnt{#1}{definition}
    \newtheorem[bodystyle=\normalfont\noindent,
    S]{#1}[#1]{#2}
    \aliascntresetthe{#1}}

\newexampleenv{example}{Example}
\newexampleenv{examples}{Examples}

\newtheorem[bodystyle=\normalfont\noindent,
            headstyle=\bfseries\boldmath Example,
            S]{example*}{Example}
\newtheorem[bodystyle=\normalfont\noindent,
            headstyle=\bfseries\boldmath Examples,
            S]{examples*}{Examples}

\fi\fi

% Theorems - Proofs

% Behaviour:
% proof          produces Proof.     QED
% proof[text]    produces text.      QED
% solution       produces Solution. [NO QED]
% solution[text] produces text.     [NO QED]

% Beamer does not produce the "."

\if@usebeamer

\let\origproof\proof
\let\origendproof\endproof

\renewenvironment{proof}[1][\proofname]{\origproof[#1\nopunct]}{\origendproof}
\renewenvironment{solution}[1][\solutionname]{\begin{proof}[#1]\renewcommand{\qedsymbol}{}}{\end{proof}}

\else
\if@useams

\newenvironment{solution}[1][\solutionname]{\begin{proof}[#1]\renewcommand{\qedsymbol}{}}{\end{proof}}

\else

\renewenvironment{proof}[1][\proofname]{%
    \list{\hspace\labelsep\textit{#1\@addpunct{.}}}{%
        \topsep=\smallskipamount%
        \partopsep=0pt%
        \leftmargin=\parindent%
        \rightmargin=\parindent%
        \listparindent=\parindent%
        \labelwidth=\parindent}%
    \item\relax\ignorespaces}%
{\parskip\z@%
    \par\noindent%
    \setbox\thmbox@box=\hbox{%
        \kern .5em\vbox{%
            \hrule width .7em height .7em
            \vskip\baselineskip}}%
    \wd\thmbox@box=0mm%
    \ht\thmbox@box=0mm%
    \hfill\box\thmbox@box%
    \endlist\par}

\newenvironment{solution}[1][\solutionname]{%
    \list{\hspace\labelsep\textit{#1\@addpunct{.}}}{%
        \topsep=\smallskipamount%
        \partopsep=0pt%
        \leftmargin=\parindent%
        \rightmargin=\parindent%
        \listparindent=\parindent%
        \labelwidth=\parindent}%
    \item\relax\ignorespaces}%
{\endlist}

\fi
\fi

